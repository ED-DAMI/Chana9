changeSet:
      id: 018-add-fk-annonces-seller
      author: chana9
      changes:
        - addForeignKeyConstraint:
            baseTableName: annonces
            baseColumnNames: seller_id
            constraintName: fk_annonces_seller
            referencedTableName: users
            referencedColumnNames: id
            onDelete: CASCADE
      rollback:
        - dropForeignKeyConstraint:
            baseTableName: annonces
            constraintName: fk_annonces_seller